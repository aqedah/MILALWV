rules_version = '2';
// MILALWV Firestore 규칙 (제안 — 연구자 승인 뒤 콘솔에 붙여 넣음). 시험: pipeline/firestore_rules_test/
service cloud.firestore {
  match /databases/{db}/documents {

    // ---- 낱말 메모 동기화 (지금 쓰는 것, 그대로) : users/{uid}/study/notes 문서 하나 ----
    match /users/{uid}/study/notes {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly(['list', 'at'])
                   && request.resource.data.list is list
                   && request.resource.data.list.size() <= 500;
    }

    // ---- 연구 기록(주석): users/{uid}/annots/{id} 문서 하나 = 메모 하나 ----
    // 와일드카드 /users/{uid}/{doc=**} 는 쓰지 않는다 — 아래 제한을 우회하기 때문
    match /users/{uid}/annots/{id} {
      function isOwner() { return request.auth != null && request.auth.uid == uid; }
      function d() { return request.resource.data; }
      // 표시(mark): 형광펜 hl · 밑줄 ul · 괄호 br. 색은 짧은 문자열(미리 정한 이름 또는 #rrggbb). 낱말이 하나는 있어야 한다
      function validMark() {
        return d().style in ['hl', 'ul', 'br']
          && d().anchor.word_ids.size() >= 1
          && d().anchor.word_ids[0] is int && d().anchor.word_ids[0] >= 1 && d().anchor.word_ids[0] <= 426590
          && (d().style != 'hl' || (d().color is string && d().color.size() <= 16 && d().color.matches('^(#[0-9a-fA-F]{6}|[a-z]{1,8})$')));
      }
      function validAnnot() {
        return d().keys().hasOnly(['id', 'kind', 'key', 'anchor', 'observation', 'interpretation', 'tags', 'mark', 'style', 'color', 'milal_ref', 'created', 'updated', 'deleted', 'shared_id', 'rev', 'server_at', 'device'])
          && d().id == id
          && d().kind in ['word', 'verse', 'atom', 'range', 'note', 'mark']
          && d().anchor is map
          && d().anchor.word_ids is list && d().anchor.word_ids.size() <= 5000
          && d().anchor.clause_atom_ids is list && d().anchor.clause_atom_ids.size() <= 1000
          && (d().kind != 'mark' || validMark())
          && d().anchor.book is int && d().anchor.book >= 1 && d().anchor.book <= 39
          && d().anchor.ch is int && d().anchor.vs is int
          && d().anchor.bhsa == '2021'
          && d().observation is string && d().observation.size() <= 2000
          && d().interpretation is string && d().interpretation.size() <= 2000
          && d().tags is list && d().tags.size() <= 20
          && d().created is int && d().updated is int
          && d().deleted is bool
          && d().rev is int && d().rev >= 1
          && d().server_at == request.time;          // 서버 시각 — 기기 시계를 믿지 않음
      }
      allow read: if isOwner();
      allow create: if isOwner() && validAnnot() && d().deleted == false && d().rev == 1;
      // 고치기: 자리(anchor)·만든 때·종류는 바꾸지 못함. rev 는 정확히 +1 (낡은 기기의 덮어쓰기 거부). 지운 것은 되살리지 못함
      allow update: if isOwner() && validAnnot()
                    && d().anchor == resource.data.anchor
                    && d().created == resource.data.created
                    && d().kind == resource.data.kind
                    && d().rev == resource.data.rev + 1
                    && !(resource.data.deleted == true && d().deleted == false);
      // 진짜 삭제 금지: 묘비(deleted=true)가 사라지면 다른 기기에서 되살아난다
      allow delete: if false;
    }

    // ---- 관리자: admins/{uid} 문서가 있으면 관리자 (콘솔에서만 만듦) ----
    function isAdmin() { return request.auth != null && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    match /admins/{uid} { allow read: if request.auth != null && request.auth.uid == uid; allow write: if false; }

    // ---- 나눔 신고: 로그인한 사람이 만들기만. 읽기는 관리자만 ----
    match /reports/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['shared_id', 'reason', 'uid', 't'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.shared_id is string && request.resource.data.shared_id.size() <= 64
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 300
        && request.resource.data.t == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ---- 나눔: 숨기지 않은 글은 누구나 읽음(목록 조회는 where('hidden','==',false) 를 붙여야 통과), 관리자는 전부.
    //      올리기는 로그인한 본인 이름으로만(hidden=false 로 시작), 내리기는 본인·관리자, 고치기는 관리자가 hidden 만 ----
    match /shared/{id} {
      allow read: if resource.data.hidden == false || isAdmin();
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.hidden == false
        && request.resource.data.keys().hasOnly(['uid', 'name', 'b', 'c', 'v', 'heb', 'gl', 'st', 'm', 'lex', 'han', 't', 'hidden'])
        && request.resource.data.b is int && request.resource.data.b >= 1 && request.resource.data.b <= 39
        && request.resource.data.c is int && request.resource.data.v is int
        && request.resource.data.m is string && request.resource.data.m.size() <= 500
        && request.resource.data.heb is string && request.resource.data.heb.size() <= 200
        && request.resource.data.gl is string && request.resource.data.gl.size() <= 200
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.t is int;
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      // 고치기는 관리자가 'hidden' 칸만 (부적절한 글 숨김). 글쓴이도 고치지 못함
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden'])
        && request.resource.data.hidden is bool;
    }

    // 그 밖은 모두 막음
    match /{path=**} { allow read, write: if false; }
  }
}
